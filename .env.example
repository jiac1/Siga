# ── Suite UNAB · variables de entorno de desarrollo ──────────────────────
# Copia este archivo como ".env" en la raíz del proyecto.
#   cp .env.example .env
# NUNCA subas .env a Git (ya está en .gitignore).
# Los valores marcados con (cambiar) deben redefinirse antes de usar en
# producción o en un entorno compartido.

# ── Modo y gateway ───────────────────────────────────────────────────────
DEBUG=True
SUITE_MODE=suite
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# ── Secreto compartido de SSO (mínimo 32 caracteres) ─────────────────────
# Usa el mismo valor en todos los servicios para que validen los JWT.
SUITE_SSO_SECRET=cambiar-por-un-secreto-de-almenos-32-caracteres-abcdef0123456789

# ── Contraseñas de servicios Django (secrets) ────────────────────────────
CORE_SECRET_KEY=cambiar-clave-secreta-core-local
MAPA_SECRET_KEY=cambiar-clave-secreta-mapa-local
ESTRES_SECRET_KEY=cambiar-clave-secreta-estres-local

# ── Base de datos (PostgreSQL en docker-compose; SQLite en pruebas) ──────
POSTGRES_PASSWORD=suite-local

# ── Usuario administrador inicial (creado con `preparar`) ────────────────
SUITE_ADMIN_EMAIL=admin@unab.cl
SUITE_ADMIN_PASSWORD=cambiar-clave-de-admin-al-iniciar

# ── Rutas ────────────────────────────────────────────────────────────────
# URL_PREFIX por servicio (se define por servicio en docker-compose y suite.py)
# CORE_URL_PREFIX=core/
# MAPA_URL_PREFIX=mapa-calor/
# ESTRES_URL_PREFIX=estres-malla/

# ── Datos del catálogo ───────────────────────────────────────────────────
# SUITE_DATA_DIR=../data

# ── Correo (SES en AWS; consola en desarrollo) ───────────────────────────
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# DEFAULT_FROM_EMAIL=Suite UNAB <no-responder@suite-unab.cl>
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=

# ── Nivel de log ─────────────────────────────────────────────────────────
# LOG_LEVEL=INFO
