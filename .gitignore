# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Environment variables & secrets
.env
.env.local
.env.*.local
!.env.example

# IDEs and editors
.vscode/
.idea/
.claude/
*.sublime-project
*.sublime-workspace

# Operating System files
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini

# Office temporary lock files
~$*
.~lock.*

# Logs and databases
*.log
# db.sqlite3 is kept for local quick demo if needed, but uncomment below if migrating to fresh db:
# *.sqlite3

# Datos locales de ejecución (no versionar)
*.sqlite3
**/media/
**/staticfiles/*
!**/staticfiles/.gitkeep
**/django_sessions/

# Infraestructura
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
.terraform.lock.hcl

# Build / herramientas
node_modules/
docs/_build/
.pytest_cache/
.coverage
htmlcov/

# Artefactos generados por Python/Django en servicios
services/*/staticfiles/
*.egg-info/
