# ── services/core · variables de entorno ─────────────────────────────────
# Copia este archivo como ".env" dentro de services/core si vas a ejecutar
# el servicio core fuera de docker-compose / suite.py.
#   cd services/core && cp .env.example .env
# NUNCA subas .env a Git.

DEBUG=True
SECRET_KEY=cambiar-clave-secreta-core-local
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8001,http://127.0.0.1:8001

# Prefijo bajo el que se publica el servicio (el ALB de AWS no reescribe rutas)
URL_PREFIX=core/
SUITE_MODE=suite
SUITE_MODULE=
SUITE_MODULE_NAME=Cuenta
SUITE_PORTAL_URL=/
SUITE_SSO_SECRET=cambiar-por-un-secreto-de-almenos-32-caracteres-abcdef0123456789
SUITE_SSO_TTL=28800
SUITE_COOKIE_DOMAIN=

# Dominios autorizados para autoregistro de estudiantes (vacío = registro cerrado)
REGISTRO_DOMINIOS=unab.cl,uandresbello.edu

# Base de datos (por defecto SQLite local; en Docker se inyecciona DATABASE_URL)
# DATABASE_URL=sqlite:///db.sqlite3
# DB_CONN_MAX_AGE=60

# Directorio del catálogo curricular (por defecto ../data respecto a este servicio)
# SUITE_DATA_DIR=

# Correo (consola en desarrollo; SES en producción)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Suite UNAB <no-responder@suite-unab.cl>

LOG_LEVEL=INFO
