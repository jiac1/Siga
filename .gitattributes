# Finales de línea: todo LF excepto los lanzadores de Windows (.bat), que usan CRLF.
* text=auto eol=lf

*.py text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.tf text eol=lf
*.tfvars text eol=lf
*.sh text eol=lf
*.bat text eol=crlf

# Binarios: no normalizar
*.db binary
*.sqlite3 binary
*.docx binary
*.pdf binary
*.xlsx binary
*.zip binary
*.png binary
*.jpg binary
